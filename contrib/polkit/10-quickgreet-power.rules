/* Lets the greeter power the machine down from the login screen.
 *
 * Install to /etc/polkit-1/rules.d/ only if the power buttons do nothing:
 * on most systems the greeter's user is already permitted through the
 * rules that ship with logind.
 *
 * Two restrictions are deliberate.
 *
 * The subject must be local and active. Without that check a greeter
 * process on an inactive VT can power the machine off — and running a
 * second greetd on a spare VT, which the README recommends for testing,
 * is exactly that situation.
 *
 * The *-multiple-sessions actions are NOT granted. Those cover the case
 * where other people are still logged in, and logind asks for
 * authentication on purpose: without it, anyone walking past the login
 * screen drops every SSH session and every locked desktop on the box.
 * Leaving them out means a passer-by can power off an otherwise idle
 * machine, and is asked to authenticate when someone else is using it.
 *
 * Adjust the user name if greetd runs as something other than "greeter".
 */
polkit.addRule(function (action, subject) {
    if (subject.user !== "greeter")
        return undefined;

    if (!subject.local || !subject.active)
        return undefined;

    var allowed = [
        "org.freedesktop.login1.power-off",
        "org.freedesktop.login1.reboot",
        "org.freedesktop.login1.suspend"
    ];

    if (allowed.indexOf(action.id) >= 0)
        return polkit.Result.YES;

    return undefined;
});
