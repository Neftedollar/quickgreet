# Maintainer: Roman Melnikov <oildollar@gmail.com>
pkgname=quickgreet
pkgver=0.1.0
pkgrel=1
pkgdesc="A greetd greeter built on Quickshell, styled after Material 3"
arch=('any')
url="https://github.com/USER/quickgreet"
license=('MIT')
depends=(
    'greetd'
    'quickshell-git'
    'python'
    'hyprland'
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
)
optdepends=(
    'python-materialyoucolor: generate a colour scheme from the wallpaper'
    'python-pillow: generate a colour scheme from the wallpaper'
)
backup=(
    'etc/quickgreet/config.json'
    'etc/quickgreet/hyprland.conf'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    install -Dm644 qml/*.qml -t "$pkgdir/usr/share/quickgreet"
    install -Dm755 scripts/*.py -t "$pkgdir/usr/lib/quickgreet"

    install -Dm644 config/config.example.json "$pkgdir/etc/quickgreet/config.json"
    install -Dm644 config/hyprland.conf -t "$pkgdir/etc/quickgreet"
    install -Dm644 config/greetd-test.toml -t "$pkgdir/etc/quickgreet"

    # Sample greetd configuration, not activated: overwriting a working
    # /etc/greetd/config.toml on install would lock people out.
    install -Dm644 config/greetd-config.toml \
        "$pkgdir/usr/share/doc/quickgreet/greetd-config.toml"

    install -Dm644 contrib/polkit/10-quickgreet-power.rules \
        "$pkgdir/usr/share/doc/quickgreet/10-quickgreet-power.rules"

    install -Dm644 README.md -t "$pkgdir/usr/share/doc/quickgreet"
    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/quickgreet"
}
