# Maintainer: Roman Melnikov <oildollar@gmail.com>
pkgname=quickgreet
pkgver=0.1.0
pkgrel=1
pkgdesc="A greetd greeter built on Quickshell, styled after Material 3"
arch=('any')
url="https://github.com/Neftedollar/quickgreet"
license=('MIT')
depends=(
    'greetd'
    'quickshell-git'
    'python'
    'hyprland'
    'ttf-material-symbols-variable'
    'ttf-rubik-vf'
    'quickmotion' 'quickmaterial'
)
optdepends=(
    'python-materialyoucolor: generate a colour scheme from the wallpaper'
    'python-pillow: generate a colour scheme from the wallpaper'
)
backup=(
    'etc/quickgreet/config.json'
    'etc/quickgreet/hyprland.conf'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/$pkgname-$pkgver"

    # Delegated rather than reimplemented: when the two were separate they
    # drifted, and the package laid files out differently from what the
    # installer and the README described.
    DESTDIR="$pkgdir" ./install.sh

    install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/quickgreet"
}
